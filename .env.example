# Copy to .env and fill in locally. Never commit .env (see .gitignore).
OPENAI_API_KEY=
MODEL_NAME=gpt-5-mini

# Retrieval routing thresholds.
# PLACEHOLDER values: not calibrated yet. They will be replaced, together
# with provenance comments, by the calibration sweep over
# eval/retrieval_calibration.json (AGENTS.md section 10).
REWRITE_FLOOR=0.10
DIRECT_ANSWER_THRESHOLD=0.30
FINAL_ANSWER_THRESHOLD=0.30

# Retrieval and input limits.
TOP_K=3
MAX_QUERY_CHARS=500

# Corpus location, relative paths are anchored to the project root.
CORPUS_DIR=data/docs
