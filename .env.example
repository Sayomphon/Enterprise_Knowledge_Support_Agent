# Copy to .env and fill in locally. Never commit .env (see .gitignore).
# The key is checked lazily, at the LLM boundary: guardrail refusals and
# low-score fallbacks run without it, and questions that need the answer
# service report `llm_not_configured` instead of failing at start-up.
OPENAI_API_KEY=
MODEL_NAME=gpt-5-mini
TEMPERATURE=0

# LLM client hardening (seconds / retry attempts).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# The rewrite boundary carries its own, tighter budget: the two LLM calls of
# a medium-band request are sequential, so their waits add up in front of the
# employee. The rewrite improves recall but does not produce the answer, so it
# is the half that is cut. Worst case 10s x 2 here plus 30s x 3 at the reporter.
LLM_REWRITE_TIMEOUT_SECONDS=10
LLM_REWRITE_MAX_RETRIES=1
# Ceiling on the whole request, shared by both boundaries: each is offered
# only what is left of it, and one reached with nothing left is skipped
# rather than started. Above the measured live p95 of 27.7s, so it bounds
# the pathological request rather than the ordinary one.
REQUEST_DEADLINE_SECONDS=45

# Retrieval routing thresholds, calibrated 2026-08-20 against
# eval/retrieval_calibration.json; derivation is documented in
# src/config.py. FINAL_ANSWER_THRESHOLD was recalibrated from 0.24 to 0.21
# once the supported-scope gate took over hard-negative rejection, and
# re-swept on 2026-08-21 after deterministic alias expansion landed in
# front of the rewrite branch: the value held, the evidence behind it
# changed, and src/config.py records both. Re-verified again on
# 2026-08-22 against the 25-case set (coverage 16/16); all three numbers
# held and the index configuration they belong to was re-swept with them.
# Do not change without re-running the calibration sweep.
REWRITE_FLOOR=0.10
DIRECT_ANSWER_THRESHOLD=0.19
FINAL_ANSWER_THRESHOLD=0.21

# Supported-scope alias similarity, calibrated 2026-08-20 on the same
# calibration set; derivation is documented in src/config.py.
SCOPE_MATCH_THRESHOLD=0.40

# Floor under the "under-specified" verdict: a query that touches two
# supported topics at or above this score, without resolving either,
# is reported as ambiguous instead of unsupported. Calibrated
# 2026-08-22 on the calibration and near-domain sets plus 23 probe
# queries; must stay below SCOPE_MATCH_THRESHOLD. See src/config.py.
SCOPE_AMBIGUOUS_MIN_SCORE=0.11

# How far below the winning topic a second topic may sit and still be
# resolved. It keeps a genuinely two-topic question (claiming a taxi
# fare AND the receipt it needs) while dropping a topic that only shares
# the winner's words. Calibrated 2026-08-22 on the calibration and
# near-domain sets plus 16 bilingual probe queries; see src/config.py.
SCOPE_TOPIC_MARGIN=0.30

# Minimum lexical continuity between a query and an accepted rewrite,
# calibrated 2026-08-20 against eval/rewrite_cases.json; see src/config.py.
REWRITE_CONTINUITY_THRESHOLD=0.05

# Retrieval and input limits.
TOP_K=3
MAX_QUERY_CHARS=500

# Corpus location, relative paths are anchored to the project root.
CORPUS_DIR=data/docs

# Append-only JSONL log for blocked and fallback events.
FALLBACK_LOG_PATH=logs/fallback_queries.jsonl

# Demo-only switch for the persistent audit surface in the Streamlit
# console. The JSONL sink holds raw employee questions from every past
# session, so it stays hidden unless this is turned on deliberately for a
# local walkthrough. It is a feature flag, not authentication or RBAC.
ENABLE_OPS_VIEW=false
